# === REQUIRED ===

# PostgreSQL connection string (Neon)
DATABASE_URL=postgresql://user:password@ep-xxxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Clerk authentication
CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
VITE_MAPBOX_TOKEN=pk.eyJ1Ijoi...

# Session secret (generate a random 64+ char string)
SESSION_SECRET=

# Required to save registration credentials in Admin Settings (AES-256-GCM).
# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep this key stable, private and backed up with the database; never commit it.
# SETTINGS_ENCRYPTION_KEY=

# Runtime
NODE_ENV=development
PORT=8080

# === OPTIONAL (can also be set in Admin → Settings) ===

# App URL (used for webhook URLs, CORS in production)
# In development, leave empty. In production, set to your Render URL.
# APP_URL=https://your-app.onrender.com

# CORS origin (comma-separated). In dev, defaults to http://localhost:5173
# CORS_ORIGIN=https://your-app.onrender.com

# Paystack payments
# PAYSTACK_PUBLIC_KEY=pk_live_...
# PAYSTACK_SECRET_KEY=sk_live_...

# Duffel Flight Booking (Sandbox)
# DUFFEL_API_TOKEN=duffel_test_xxxxxxx
# Separate test/live tokens can also be configured in the super-admin Duffel settings.
# DUFFEL_TEST_API_TOKEN=
# DUFFEL_LIVE_API_TOKEN=
# DUFFEL_WEBHOOK_ID_TEST=
# DUFFEL_WEBHOOK_SECRET_TEST=
# DUFFEL_WEBHOOK_ID_LIVE=
# DUFFEL_WEBHOOK_SECRET_LIVE=
# Apply 0010_duffel_webhooks.sql and 0011_ota_revision.sql, deploy, import webhook secrets, then Ping and Activate in admin.
# OTA configuration is managed by a super_admin at /admin/ota.
# Flights, hotels and online sales start disabled. Request Duffel Stays access.
# SET SETTINGS_ENCRYPTION_KEY (above) before storing the Duffel token in the console.
# Configure supplier-currency-to-NGN rates in the console; there is no fixed FX fallback.
# Paystack mode must match Duffel mode. APP_URL must be HTTPS to enable sales.
# Existing /api/payments/paystack/webhook accepts both package and OTA payments.
# Apply lib/db/drizzle/0009_ota.sql before enabling OTA features.
# OTA_MODE=test                   # Match the EXISTING Paystack mode; sales remain disabled until enabled by super admin.
# OTA_FLIGHTS_ENABLED=false       # Initial defaults; saved admin switches take precedence.
# OTA_HOTELS_ENABLED=false
# OTA_SALES_ENABLED=false
# OTA_DEFAULT_RATES='{"NGN":1}'   # Initial defaults only; saved admin rates take precedence.
# OTA_DEFAULT_RATES_AS_OF=YYYY-MM-DD
# OTA_SUPPORT_EMAIL=
# OTA_SUPPORT_PHONE=
# OTA_FX_REFERENCE_ENABLED=true
# OTA_FX_PROVIDER=frankfurter      # No-key daily references; or exchangerate_api for your provider-plan schedule.
# OTA_FX_REFRESH_SECONDS=900       # Server cache; UI checks once per minute.
# EXCHANGERATE_API_KEY=            # Optional, server-only; never use a VITE_ prefix for private keys.

# AI-assisted registration (WhatsApp + Telegram intake channels)
# Keep AI_REGISTRATION_ENABLED=false until webhooks are configured and tested.
# AI_REGISTRATION_ENABLED=false
# AI_REGISTRATION_SESSION_TTL_HOURS=48
#
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_API_VERSION=v21.0
#
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=

# AI registration production controls
# AI_REGISTRATION_AUTO_FALLBACK=true
# AI_REGISTRATION_RATE_LIMIT_PER_MIN=20
# GEMINI_PASSPORT_MODEL=gemini-3.8-flash
# MISTRAL_PASSPORT_MODEL=mistral-small-latest
# WHATSAPP_API_VERSION=        # Set a version currently supported by your Meta app
# WHATSAPP_REVIEW_TEMPLATE=registration_review_outcome
# WHATSAPP_TEMPLATE_LANGUAGE=en
# TELEGRAM_BOT_USERNAME=
# TRUST_PROXY_HOPS=1           # Set only for your actual reverse-proxy topology
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=raudah-uploads
