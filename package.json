{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "dev:frontend": "pnpm --filter @workspace/raudah-travels run dev",
    "dev": "npx concurrently \"pnpm run dev:api\" \"pnpm run dev:frontend\"",
    "build": "pnpm -r --if-present run build",
    "build:api": "pnpm --filter @workspace/api-server run build",
    "build:frontend": "pnpm --filter @workspace/raudah-travels run build",
    "db:push": "pnpm --filter @workspace/db run push",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "cross-env": "^7.0.3",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "dotenv": "^16.6.1",
    "pg": "^8.20.0"
  }
}
